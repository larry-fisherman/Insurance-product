# Copy to services/backend/.env for native development.
# Required. Staging/production are deliberately unavailable before the security foundation.
CGL_APP_ENV=local
# Full local platform configuration is generated by make app-config in .env.app.
# Optional platform settings (never put real provider secrets in this example):
# CGL_AUTH_MODE=local
# CGL_PUBLIC_ORIGIN=http://localhost:3000
# CGL_MARKETING_ORIGIN=http://127.0.0.1:3001
# CGL_SESSION_IDLE_MINUTES=30
# CGL_PARSER_ENDPOINT=http://parser:8020
# OIDC requires all endpoints, a test client, verified email and MFA amr:
# CGL_AUTH_MODE=oidc
# CGL_OIDC_ISSUER=https://identity.example.invalid
# CGL_OIDC_CLIENT_ID=fictional-test-client
# CGL_OIDC_CLIENT_SECRET=<configure privately>
# CGL_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.invalid/authorize
# CGL_OIDC_TOKEN_ENDPOINT=https://identity.example.invalid/token
# CGL_OIDC_JWKS_URI=https://identity.example.invalid/keys
# CGL_OIDC_REQUIRED_AMR=mfa
