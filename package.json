{
  "name": "cgl-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <26",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace @cgl/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @cgl/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:generate": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/api.d.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "dev:marketing": "npm run dev --workspace @cgl/marketing"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10"
  }
}
